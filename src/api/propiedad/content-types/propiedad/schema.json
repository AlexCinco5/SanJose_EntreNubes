{
  "kind": "collectionType",
  "collectionName": "propiedads",
  "info": {
    "singularName": "propiedad",
    "pluralName": "propiedads",
    "displayName": "Propiedad"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Titulo": {
      "type": "string"
    },
    "Descripcion": {
      "type": "string"
    },
    "Precio_Noche": {
      "type": "decimal"
    },
    "Huespedes": {
      "type": "integer"
    },
    "Habitaciones": {
      "type": "integer"
    },
    "Banos": {
      "type": "integer"
    },
    "Imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Estado": {
      "type": "enumeration",
      "enum": [
        "Publicado",
        "Pausado"
      ]
    },
    "reservas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reserva.reserva",
      "mappedBy": "propiedad"
    }
  }
}
